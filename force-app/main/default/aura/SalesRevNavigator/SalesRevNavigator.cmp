<!--
  @description       : Lightning host that embeds the Explori Sales RevNavigator Canvas app on a record or Home page, passing only the current record Id.
  @author            : Mayank Singh
  @group             :
  @last modified on  : 10-14-2026
  @last modified by  : Mayank Singh
-->
<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId" access="global">

    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="displayDensity" type="String" default="sidebar" access="global"/>
    <aura:attribute name="canvasParams" type="String" default="{}"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <div class="slds-is-relative">
        <force:canvasApp
            developerName="Explori_Sales_RevNavigator"
            width="100%"
            height="640px"
            border="false"
            scrolling="true"
            parameters="{!v.canvasParams}"/>
    </div>
</aura:component>